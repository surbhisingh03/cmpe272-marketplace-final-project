PORT=5001
NODE_ENV=development

# Optional: set to 1 so JSON errors include `message` when NODE_ENV=production (localhost still auto-exposes).
# FUSIONHUB_EXPOSE_ERRORS=1

# --- Database (Supabase / PostgreSQL) ---
# Get this from: Supabase → Project Settings → Database → Connection string → URI
# Use the "Transaction pooler" (port 6543) for Node apps. Replace [YOUR-PASSWORD]
# with the database password set when you created the Supabase project.
#
# Example:
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional — only needed if you also use the Supabase JS client / Storage / Auth
# from server or client code. Not required for the current Node API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES=7d

# Optional: when "true", Facebook-only users (no password yet) can set their password by submitting
# email + password on /api/auth/login once. When omitted, this is allowed automatically in development
# only (NODE_ENV !== production). Set to "false" to disable even in development.
# AUTH_LINK_PASSWORD_ON_LOGIN=true

CLIENT_ORIGIN=http://localhost:5173

# --- Facebook Login (optional) ---
# Create an app at https://developers.facebook.com/apps/ → Facebook Login → Settings.
# Valid OAuth Redirect URIs must include the URL below exactly (use https in production).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5001/api/auth/facebook/callback

# Admin API (must match a real user email in DB — seed creates this account)
ADMIN_EMAIL=admin@fusionhub.demo
ADMIN_PASSWORD=fusionhub123
