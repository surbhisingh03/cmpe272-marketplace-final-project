PORT=5001
NODE_ENV=development

# --- Database (Supabase / PostgreSQL) ---
# Get this from: Supabase → Project Settings → Database → Connection string → URI
# Use the "Transaction pooler" (port 6543) for Node apps. Replace [YOUR-PASSWORD]
# with the database password set when you created the Supabase project.
#
# Example:
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional — only needed if you also use the Supabase JS client / Storage / Auth
# from server or client code. Not required for the current Node API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES=7d

CLIENT_ORIGIN=http://localhost:5173

# Admin API (must match a real user email in DB — seed creates this account)
ADMIN_EMAIL=admin@fusionhub.demo
ADMIN_PASSWORD=fusionhub123
